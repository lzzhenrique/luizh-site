---
import { STAGES, type Stage } from '../lib/garden';

interface Props {
  stage: Stage;
  /** mostra o nome do estágio ao lado do ícone */
  showLabel?: boolean;
}

const { stage, showLabel = false } = Astro.props;
const info = STAGES[stage];
---

<span class={`glyph glyph-${stage}`} title={showLabel ? undefined : `${info.label}: ${info.hint}`}>
  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
    {stage === 'semente' && <ellipse cx="8" cy="9" rx="3.2" ry="2.6" fill="currentColor" />}
    {stage === 'broto' && (
      <>
        <path d="M8 14.5V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none" />
        <path d="M8 8C8 5 6 3.5 3 3.5 3 6.5 5 8 8 8Z" fill="currentColor" />
        <path d="M8 7C8 4.5 9.5 3 13 3 13 6 11 7 8 7Z" fill="currentColor" />
      </>
    )}
    {stage === 'perene' && (
      <>
        <path d="M8 1 12 6.5H4Z" fill="currentColor" />
        <path d="M8 4.5 13 11H3Z" fill="currentColor" />
        <path d="M8 11v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
      </>
    )}
  </svg>
  {showLabel ? <span class="glyph-label">{info.label}</span> : <span class="sr-only">{info.label}: </span>}
</span>
